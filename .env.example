# Copie para .env só se for rodar a função localmente (netlify dev). Em produção, cadastre no painel do Netlify.
# NUNCA faça commit do .env.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-anon-publica
# Chave secreta: fica só no servidor (função do Netlify). Nunca coloque no front-end.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# Senha de acesso do administrador (obrigatória em produção)
ADMIN_PASSWORD=troque-esta-senha
