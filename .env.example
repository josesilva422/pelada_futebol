# Copie para .env só se for rodar a função localmente (netlify dev). Em produção, cadastre no painel do Netlify.
# NUNCA faça commit do .env.

# Project URL: Project Settings > Data API (ou https://<Reference ID>.supabase.co)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Project Settings > API Keys > "Publishable key" (sb_publishable_...). Pública, vai para o navegador.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Project Settings > API Keys > "Secret keys" (sb_secret_...). Fica só no servidor (função do Netlify).
# Nunca coloque no front-end nem no Git.
SUPABASE_SECRET_KEY=sb_secret_...

# Senha de acesso do administrador (obrigatória em produção)
ADMIN_PASSWORD=troque-esta-senha
